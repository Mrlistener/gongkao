#!/bin/sh
# 提交前拦截个人隐私（真实姓名 / 工作邮箱 / 手机号 / 身份证号 / 私人邮箱）
# 命中即拒绝提交，避免「不小心把真名提交上去」这类事故。

pattern='李兆祥|lizhaoxiang|smalleels|小鳗|(^|[^0-9])1[3-9][0-9]{9}([^0-9]|$)|(^|[^0-9])[0-9]{17}[0-9Xx]([^0-9]|$)|@qq\.com|@163\.com|@gmail\.com'

# 排除本目录自身（否则规则字符串会命中自己）
added=$(git diff --cached -U0 -- . ':(exclude).githooks/**' | grep '^+' | grep -v '^+++')

if [ -n "$added" ]; then
  hits=$(printf '%s\n' "$added" | grep -nE "$pattern")
  if [ -n "$hits" ]; then
    echo '' >&2
    echo '  ✗ 提交被拦截：检测到疑似个人隐私' >&2
    printf '%s\n' "$hits" | head -n 8 >&2
    echo '' >&2
    echo '  命中规则：真实姓名 / 工作邮箱 / 手机号 / 身份证号 / 私人邮箱' >&2
    echo '  确认无误后可用 git commit --no-verify 跳过（不建议）' >&2
    exit 1
  fi
fi

exit 0